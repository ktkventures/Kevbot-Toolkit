{
  "$schema": "pack_spec_v1",
  "slug": "swing_123_test",
  "name": "Swing 1-2-3 Test",
  "category": "Custom",
  "description": "Detects Swing 1-2-3 candle patterns where C2 absorbs pressure and C3 confirms breakout/breakdown",
  "author": "user",
  "version": "2.0.0",
  "created_at": "2026-04-26T00:00:00Z",
  "pack_type": "tf_confluence",
  "display_type": "overlay",
  "interpreters": ["SWING_123_TEST"],
  "trigger_prefix": "s123t",
  "parameters_schema": {
    "min_c2_wick_pct": {
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "label": "Min Candle 2 Wick Extension % (0 = any)"
    },
    "lookback_bars": {
      "type": "int",
      "default": 1,
      "min": 1,
      "max": 5,
      "label": "Candle 1 Lookback (bars before C2)"
    }
  },
  "plot_schema": {
    "bullish_c2_color": {
      "type": "color",
      "default": "#FFD11A",
      "label": "Bullish C2 Candle Color"
    },
    "bullish_c3_color": {
      "type": "color",
      "default": "#FFFF00",
      "label": "Bullish C3 Candle Color"
    },
    "bearish_c2_color": {
      "type": "color",
      "default": "#FF66B3",
      "label": "Bearish C2 Candle Color"
    },
    "bearish_c3_color": {
      "type": "color",
      "default": "#FF33CC",
      "label": "Bearish C3 Candle Color"
    }
  },
  "outputs": [
    "NEUTRAL",
    "BULLISH_C2",
    "BULLISH_C3",
    "BEARISH_C2",
    "BEARISH_C3"
  ],
  "output_descriptions": {
    "NEUTRAL": "No active Swing 1-2-3 pattern forming or recently completed.",
    "BULLISH_C2": "Bullish setup candle: lower low than the prior bar AND closed above the prior bar's close.",
    "BULLISH_C3": "Bullish breakout confirmed: prior bar was a Bullish C2 AND current close above prior bar's high.",
    "BEARISH_C2": "Bearish setup candle: higher high than the prior bar AND closed below the prior bar's close.",
    "BEARISH_C3": "Bearish breakdown confirmed: prior bar was a Bearish C2 AND current close below prior bar's low."
  },
  "triggers": [
    {
      "base": "bullish_c2_detected",
      "name": "Bullish C2 Setup Detected",
      "direction": "BOTH",
      "type": "BOTH"
    },
    {
      "base": "bullish_c3_confirmed",
      "name": "Bullish C3 Breakout Confirmed",
      "direction": "BOTH",
      "type": "BOTH"
    },
    {
      "base": "bearish_c2_detected",
      "name": "Bearish C2 Setup Detected",
      "direction": "BOTH",
      "type": "BOTH"
    },
    {
      "base": "bearish_c3_confirmed",
      "name": "Bearish C3 Breakdown Confirmed",
      "direction": "BOTH",
      "type": "BOTH"
    },
    {
      "base": "pattern_reset",
      "name": "Pattern Reset to Neutral",
      "direction": "BOTH",
      "type": "BOTH"
    }
  ],
  "trigger_levels": {
    "bullish_c2_detected": {
      "level_column": "sw123t_bull_entry_level_prev",
      "cross": "above"
    },
    "bearish_c2_detected": {
      "level_column": "sw123t_bear_entry_level_prev",
      "cross": "below"
    }
  },
  "indicator_columns": [
    "sw123t_bull_c2",
    "sw123t_bear_c2",
    "sw123t_bull_c3",
    "sw123t_bear_c3",
    "sw123t_candle_color",
    "sw123t_bull_entry_level_prev",
    "sw123t_bear_entry_level_prev"
  ],
  "column_color_map": {},
  "plot_config": {
    "candle_color_column": "sw123t_candle_color"
  },
  "indicator_function": "calculate_swing_123_test",
  "interpreter_function": "interpret_swing_123_test",
  "trigger_function": "detect_swing_123_test_triggers",
  "requires_indicators": [
    "sw123t_bull_c2",
    "sw123t_bear_c2",
    "sw123t_bull_c3",
    "sw123t_bear_c3"
  ],
  "incremental_class": {
    "module": "indicator_incremental",
    "class_name": "Swing123TestIncremental"
  }
}
