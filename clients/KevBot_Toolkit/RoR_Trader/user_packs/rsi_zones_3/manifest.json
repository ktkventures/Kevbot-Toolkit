{
  "$schema": "pack_spec_v1",
  "slug": "rsi_zones_3",
  "name": "RSI Zones 3",
  "category": "Mean Reversion",
  "description": "RSI with three-zone classification (overbought, neutral, oversold), optional smoothing, and level-cross triggers",
  "author": "user",
  "version": "2.0.0",
  "created_at": "2026-04-26T00:00:00Z",
  "pack_type": "tf_confluence",
  "display_type": "oscillator",
  "interpreters": ["RSI_ZONES_3"],
  "trigger_prefix": "rsi3",
  "parameters_schema": {
    "rsi_period":       {"type": "int",   "default": 14, "min": 2,  "max": 50, "label": "RSI Period"},
    "overbought_level": {"type": "float", "default": 70, "min": 55, "max": 90, "label": "Overbought Level"},
    "oversold_level":   {"type": "float", "default": 30, "min": 10, "max": 45, "label": "Oversold Level"},
    "source":           {"type": "str",   "default": "close",                  "label": "Price Source"},
    "smoothing":        {"type": "int",   "default": 1,  "min": 1,  "max": 10, "label": "RSI Smoothing Period"}
  },
  "plot_schema": {
    "rsi_color":    {"type": "color", "default": "#8b5cf6", "label": "RSI Line Color"},
    "signal_color": {"type": "color", "default": "#f59e0b", "label": "Smoothed RSI Color"}
  },
  "plot_config": {
    "reference_lines": [
      {"value": 70, "color": "#ef4444", "label": "Overbought"},
      {"value": 30, "color": "#22c55e", "label": "Oversold"},
      {"value": 50, "color": "#6b7280", "label": "Midline"}
    ],
    "line_styles": {"rsi_z3_signal": 2}
  },
  "outputs": ["OVERBOUGHT", "NEUTRAL", "OVERSOLD"],
  "output_descriptions": {
    "OVERBOUGHT": "RSI is at or above the overbought level, indicating bullish exhaustion or overextension",
    "NEUTRAL": "RSI is between the oversold and overbought levels, indicating no extreme condition",
    "OVERSOLD": "RSI is at or below the oversold level, indicating bearish exhaustion or overextension"
  },
  "triggers": [
    {"base": "cross_into_overbought", "name": "RSI Crosses Into Overbought",   "direction": "BOTH", "type": "BOTH"},
    {"base": "cross_into_oversold",   "name": "RSI Crosses Into Oversold",     "direction": "BOTH", "type": "BOTH"},
    {"base": "exit_overbought_zone",  "name": "RSI Exits Overbought Zone",     "direction": "BOTH", "type": "BOTH"},
    {"base": "exit_oversold_zone",    "name": "RSI Exits Oversold Zone",       "direction": "BOTH", "type": "BOTH"},
    {"base": "overbought_long_exit",  "name": "RSI Overbought Exit Signal",    "direction": "BOTH", "type": "BOTH"},
    {"base": "oversold_short_exit",   "name": "RSI Oversold Exit Signal",      "direction": "BOTH", "type": "BOTH"}
  ],
  "indicator_columns": ["rsi_z3", "rsi_z3_signal"],
  "column_color_map": {
    "rsi_z3": "rsi_color",
    "rsi_z3_signal": "signal_color"
  },
  "indicator_function": "calculate_rsi_zones_3",
  "interpreter_function": "interpret_rsi_zones_3",
  "trigger_function": "detect_rsi_zones_3_triggers",
  "requires_indicators": ["rsi_z3", "rsi_z3_signal"],
  "incremental_class": {
    "module": "indicator_incremental",
    "class_name": "RsiZones3Incremental"
  }
}
