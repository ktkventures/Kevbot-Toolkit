{
  "$schema": "pack_spec_v1",
  "slug": "macd_histogram_v2",
  "name": "MACD Histogram v2",
  "category": "Momentum",
  "description": "MACD histogram = macd_line - macd_signal. Four states (H+up/H+dn/H-up/H-dn) plus zero-flip and V-shape momentum-shift triggers.",
  "author": "user",
  "version": "1.0.0",
  "created_at": "2026-04-26T00:00:00Z",
  "pack_type": "tf_confluence",
  "display_type": "oscillator",
  "interpreters": ["MACD_HISTOGRAM_V2"],
  "trigger_prefix": "mhv2",
  "parameters_schema": {
    "fast_period":   {"type": "int", "default": 12, "min": 2, "max": 50,  "label": "Fast EMA Period"},
    "slow_period":   {"type": "int", "default": 26, "min": 5, "max": 100, "label": "Slow EMA Period"},
    "signal_period": {"type": "int", "default": 9,  "min": 2, "max": 30,  "label": "Signal EMA Period"}
  },
  "plot_schema": {
    "hist_color": {"type": "color", "default": "#94a3b8", "label": "Histogram Color"}
  },
  "outputs": ["H+up", "H+dn", "H-up", "H-dn"],
  "output_descriptions": {
    "H+up": "Histogram positive AND rising — bullish momentum strengthening",
    "H+dn": "Histogram positive AND falling — bullish momentum weakening",
    "H-up": "Histogram negative AND rising — bearish momentum weakening",
    "H-dn": "Histogram negative AND falling — bearish momentum strengthening"
  },
  "triggers": [
    {"base": "flip_pos",            "name": "Histogram Flips Positive",                  "direction": "BOTH", "type": "BOTH"},
    {"base": "flip_neg",            "name": "Histogram Flips Negative",                  "direction": "BOTH", "type": "BOTH"},
    {"base": "momentum_shift_up",   "name": "Momentum Shift Up (V-shape rising)",        "direction": "BOTH", "type": "BOTH"},
    {"base": "momentum_shift_down", "name": "Momentum Shift Down (inverted-V falling)",  "direction": "BOTH", "type": "BOTH"}
  ],
  "indicator_columns": ["mhv2_line", "mhv2_signal", "mhv2_hist"],
  "column_color_map": {"mhv2_hist": "hist_color"},
  "indicator_function": "calculate_macd_histogram_v2",
  "interpreter_function": "interpret_macd_histogram_v2",
  "trigger_function": "detect_macd_histogram_v2_triggers",
  "requires_indicators": ["mhv2_hist"],
  "incremental_class": {
    "module": "indicator_incremental",
    "class_name": "MacdHistogramV2Incremental"
  }
}
