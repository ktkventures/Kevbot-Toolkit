FROM python:3.12-slim

WORKDIR /app

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code (batch_worker imports recompute_jobs, forward_test_service,
# services, pack_registry, db; copy set kept identical to the live worker so the
# spawn pool workers can re-import the full engine).
COPY src/ ./src/
COPY config/ ./config/
COPY user_packs/ ./user_packs/
COPY reference-indicators/ ./reference-indicators/

# Liveness: batch_worker touches this on a daemon thread every ~5s, independent
# of (multi-minute) job duration.
HEALTHCHECK --interval=60s --timeout=5s --retries=3 \
    CMD test -f /tmp/batch_worker_alive || exit 1

CMD ["python", "src/batch_worker.py"]
