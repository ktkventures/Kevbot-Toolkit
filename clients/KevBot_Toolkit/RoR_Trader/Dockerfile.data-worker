FROM python:3.12-slim

WORKDIR /app

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code (data-worker imports data_loader, bar_store,
# pack_registry; copy set kept identical to the live worker for safety).
COPY src/ ./src/
COPY config/ ./config/
COPY user_packs/ ./user_packs/
COPY reference-indicators/ ./reference-indicators/

HEALTHCHECK --interval=60s --timeout=5s --retries=3 \
    CMD test -f /tmp/data_worker_alive || exit 1

CMD ["python", "src/data_worker.py"]
