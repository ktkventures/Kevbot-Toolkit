//@version=6
// Auto-generated by RoR Trader → TradingView export. Strategy: SPY-CANARY-1m-Control
// Symbol SPY · primary 1Min · session RTH
// Faithful port: hand-rolled indicator seeding to match our engine.
// Seconds charts hold only a few days of history on TradingView;
// extended-hours tape is sparse (use RTH for the cleanest parity).
strategy("SPY-CANARY-1m-Control [RoR port]", overlay=true, default_qty_type=strategy.fixed, default_qty_value=1, process_orders_on_close=true, calc_on_every_tick=false, pyramiding=0)

rorEma(float src, int period) =>
    var float e = na
    a = 2.0 / (period + 1)
    e := na(e) ? src : a * src + (1.0 - a) * e
    e

rorTrueRange() =>
    na(close[1]) ? (high - low)
         : math.max(high - low, math.abs(high - close[1]), math.abs(low - close[1]))

// ── primary pack: ut_bot_v4 ──
var float atr  = na
var float stop = na
var float pc   = na
bool bullFlip = false
bool bearFlip = false
if na(stop)
    tr = high - low
    atr  := tr
    stop := close - 1.0 * tr
    pc   := close
else
    tr = math.max(high - low, math.abs(high - pc), math.abs(low - pc))
    atr := atr + (1.0 / 10) * (tr - atr)
    nLoss = 1.0 * atr
    ps = stop
    float ns = na
    if close > ps and pc > ps
        ns := math.max(ps, close - nLoss)
    else if close < ps and pc < ps
        ns := math.min(ps, close + nLoss)
    else if close > ps
        ns := close - nLoss
    else
        ns := close + nLoss
    bullFlip := pc <= ps and close > ns
    bearFlip := pc >= ps and close < ns
    stop := ns
    pc   := close
entrySig = bullFlip
exitSig  = bearFlip

gateAll = true

// ── stop ──
stopAtrLen = 14
stopMult = 1.5
atrStopSeries = rorEma(rorTrueRange(), stopAtrLen)

// ── orders ──
entryGated = entrySig and gateAll
var float stopLevel = na
if entryGated and strategy.position_size == 0
    strategy.entry("L", strategy.long)
    stopLevel := close - stopMult * atrStopSeries
if strategy.position_size > 0 and not na(stopLevel)
    strategy.exit("stop", from_entry="L", stop=stopLevel, comment="stop_loss")
if exitSig and strategy.position_size > 0
    strategy.close("L", comment="utv4_bear_flip")

// ── visuals ──
plot(strategy.position_size > 0 ? stopLevel : na, "stop", color.new(color.red, 0), 1, plot.style_linebr)
plotshape(entryGated and strategy.position_size == 0, "entry", shape.triangleup, location.belowbar, color.new(color.green, 0), size=size.tiny)
