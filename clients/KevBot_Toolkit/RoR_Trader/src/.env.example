# Alpaca Market Data API
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET_KEY=your_alpaca_secret_key
ALPACA_DATA_FEED=sip

# Supabase (Phase 22 — set USE_DB=true to activate database mode)
USE_DB=false
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# AI Providers (Pack Builder — optional, enable the ones you have)
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key


# Polygon flat-file S3 credentials (Phase E) — generate in your Polygon dashboard.
# Note: Polygon's S3 secret_key is the same value as your POLYGON_API_KEY.
POLYGON_S3_ACCESS_KEY=your_polygon_s3_access_key
POLYGON_S3_SECRET_KEY=your_polygon_api_key
FLAT_FILE_SYMBOLS=SPY,TSLA