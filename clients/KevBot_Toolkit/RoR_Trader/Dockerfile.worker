FROM python:3.12-slim

WORKDIR /app

# Install Python dependencies (worker needs fewer than the web app)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code (worker imports ralph_engine, alerts, indicators, etc.)
COPY src/ ./src/
COPY config/ ./config/
COPY user_packs/ ./user_packs/
COPY reference-indicators/ ./reference-indicators/

HEALTHCHECK --interval=60s --timeout=5s --retries=3 \
    CMD test -f /tmp/worker_alive || exit 1

CMD ["python", "src/worker.py"]
