FROM python:3.12-slim

WORKDIR /app

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code. Kept identical to the batch-worker so the resident engine
# (Step C) can re-import the full engine + pack registry: shadow_worker imports
# bar_cache, services, unified_engine, pack_registry, db.
COPY src/ ./src/
COPY config/ ./config/
COPY user_packs/ ./user_packs/
COPY reference-indicators/ ./reference-indicators/

# Liveness: shadow_worker touches this on a daemon thread every ~5s, independent
# of work duration (a multi-second resident tick must not trip the HEALTHCHECK).
HEALTHCHECK --interval=60s --timeout=5s --retries=3 \
    CMD test -f /tmp/shadow_worker_alive || exit 1

CMD ["python", "src/shadow_worker.py"]
