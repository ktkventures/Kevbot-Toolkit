FROM python:3.12-slim

WORKDIR /app

# Install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy source + user packs
COPY src/ ./src/
COPY user_packs/ ./user_packs/

# Environment
ENV USE_DB=true
ENV PYTHONPATH=/app/src

# Health check
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl --fail http://localhost:${PORT:-8000}/health || exit 1

# Run FastAPI — single worker so mass_builder's in-memory _active_searches
# dict is shared across all requests (POST /run writes it; GET /progress reads
# it; with >1 worker these hit separate processes and state is lost). Moving
# to Redis/DB for shared state is the proper multi-worker solution; tracked
# for M9 scale work.
CMD uvicorn api.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1
